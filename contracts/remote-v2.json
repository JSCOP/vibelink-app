{
  "contractVersion": 3,
  "protocolVersion": 2,
  "subprotocol": "vibelink-remote-v2",
  "noiseSuite": "Noise_XX_25519_ChaChaPoly_BLAKE2s",
  "authorization": "paired-device-key",
  "accountAuthorization": false,
  "sessionAuth": {
    "pairRequired": [
      "mode",
      "code",
      "deviceName"
    ],
    "resumeRequired": [
      "mode",
      "deviceId",
      "revocationEpoch"
    ],
    "peerIdentity": "noise-static-key-fingerprint",
    "tlsIdentity": "sha256-certificate-pin",
    "liveGrantRecheck": true,
    "liveEpochRecheck": true,
    "defaultPairingGrants": [
      "terminal.view",
      "terminal.input"
    ]
  },
  "canonicalization": {
    "encoding": "utf-8",
    "lineEndings": "lf",
    "finalNewline": true,
    "objectMemberOrder": "source-order",
    "arrayOrder": "significant",
    "hash": "sha256-file-bytes"
  },
  "schema": {
    "dialect": "vibelink-json-schema-subset-v1",
    "references": "local-types-only",
    "optionalFieldRule": "property-present-and-not-required",
    "integerFormats": [
      "uint16",
      "uint32",
      "uint64",
      "int32",
      "int64"
    ],
    "typedObjectUnknownFields": "reject",
    "preservedOpaqueDomains": [
      "system",
      "notifications",
      "orchestration",
      "browser",
      "files",
      "git",
      "account",
      "dictation"
    ]
  },
  "canonicalKeys": {
    "workspace": [
      "workspaceId",
      "viewGeneration"
    ],
    "terminal": [
      "paneId",
      "subscriptionId",
      "streamId",
      "dataBase64",
      "sequence",
      "paneGeneration",
      "firstLiveSequence",
      "snapshotBytes",
      "snapshotChunks"
    ],
    "lease": [
      "leaseId",
      "leaseRevision",
      "viewportRevision",
      "cols",
      "rows"
    ]
  },
  "envelope": {
    "required": [
      "version",
      "requestId",
      "domain",
      "method",
      "operationId",
      "sequence",
      "revocationEpoch",
      "payload"
    ],
    "responseRequired": [
      "version",
      "requestId",
      "domain",
      "method",
      "operationId",
      "sequence",
      "revocationEpoch",
      "payload",
      "error"
    ],
    "sequenceScope": "device-session-domain",
    "sequenceStartsAt": 1,
    "operationIdFormat": "uuid",
    "operationReplayWindow": 4096,
    "unknownFields": "ignore",
    "typedPayloadUnknownFields": "reject",
    "unknownMethods": "typed-error"
  },
  "sequence": {
    "duplicateError": "sequence_replay",
    "gapError": "sequence_gap",
    "gapRequiresResync": true,
    "resyncMethod": "system.resync",
    "maxResyncAdvance": 4096,
    "resyncPayloadRequired": [
      "domain",
      "nextSequence"
    ]
  },
  "binaryFrame": {
    "header": [
      "version:u8",
      "channel:u8",
      "flags:u16be",
      "streamId:u64be",
      "sequence:u64be",
      "droppedBefore:u32be",
      "payloadLength:u32be"
    ],
    "headerBytes": 28,
    "maxPayloadBytes": 61440,
    "flags": {
      "final": 1,
      "keyframe": 2,
      "resync": 4,
      "droppedBefore": 8
    },
    "channels": {
      "terminalOutput": 1,
      "terminalSnapshot": 2,
      "browserScreencast": 3,
      "screenshot": 4,
      "file": 5,
      "attachment": 6,
      "emulator": 7
    },
    "delivery": {
      "terminalOutput": "ordered-lossless-gap-resync",
      "terminalSnapshot": "ordered-lossless",
      "browserScreencast": "latest-frame-wins-with-drop-count",
      "screenshot": "ordered-lossless",
      "file": "ordered-lossless",
      "attachment": "ordered-lossless",
      "emulator": "latest-frame-wins-with-drop-count"
    },
    "dropAccounting": {
      "allowedChannels": [
        "browserScreencast",
        "emulator"
      ],
      "field": "droppedBefore",
      "flag": "droppedBefore",
      "losslessChannelsRequireZero": true
    },
    "terminalOrdering": {
      "sequenceScope": "subscription",
      "sequenceStartsAt": 1,
      "sequenceIncrement": 1,
      "snapshotFramesBeforeLiveFrames": true,
      "snapshotChannel": "terminalSnapshot",
      "liveChannel": "terminalOutput",
      "subscribeFirstLiveSequenceField": "firstLiveSequence",
      "gapOrResyncFlagSnapshotRequests": 1,
      "gapSnapshotMethod": "terminal.snapshot",
      "gapSnapshotReason": "gap"
    },
    "terminalFlowControl": {
      "ackMethod": "terminal.ack",
      "ackAfterBytes": 65536,
      "ackAfterMs": 50,
      "maxUnackedBytesPerStream": 524288,
      "maxUnackedBytesPerConnection": 2097152,
      "coalesceMaxBytes": 49152,
      "coalesceMaxMs": 8
    }
  },
  "types": {
